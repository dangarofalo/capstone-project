# Copy to .env and fill in. Never commit .env (it is in .gitignore).

# Domain or computer name the dashboard is reached at. Use a real domain pointed at
# this server for a trusted certificate, or "localhost" for testing on this machine.
SENTINEL_DOMAIN=localhost

# Database password: letters and digits only (it goes inside a connection URL).
POSTGRES_PASSWORD=

# Signs login sessions. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SENTINEL_SECRET_KEY=

# First administrator, created on first start if there are no users yet.
# Change the password after signing in (My account page).
SENTINEL_ADMIN_USERNAME=admin
SENTINEL_ADMIN_PASSWORD=

# Business hours for the after-hours login rule.
SENTINEL_TIMEZONE=America/New_York
SENTINEL_WORK_HOURS_START=7
SENTINEL_WORK_HOURS_END=19

# Optional: email new high-severity alerts.
SENTINEL_SMTP_HOST=
SENTINEL_SMTP_PORT=587
SENTINEL_SMTP_USER=
SENTINEL_SMTP_PASSWORD=
SENTINEL_SMTP_FROM=
SENTINEL_ALERT_EMAIL_TO=
