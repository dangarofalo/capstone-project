# Caddy gets and renews an HTTPS certificate automatically:
#  - a real domain (e.g. sentinel.example.com) gets a free Let's Encrypt certificate
#  - "localhost" or a LAN name gets a certificate from Caddy's own local authority
{$SENTINEL_DOMAIN} {
	encode gzip
	reverse_proxy app:8000
	header Strict-Transport-Security "max-age=31536000"
}
